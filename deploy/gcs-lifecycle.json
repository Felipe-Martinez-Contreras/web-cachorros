{
  "rule": [
    {
      "action": { "type": "Delete" },
      "condition": { "age": 14, "matchesPrefix": ["db/diario/"] }
    },
    {
      "action": { "type": "Delete" },
      "condition": { "age": 365, "matchesPrefix": ["db/mensual/"] }
