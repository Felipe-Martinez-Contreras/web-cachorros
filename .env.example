# ───────────────────────────────────────────────────────────────
# Club Deportivo Los Cachorros · variables de entorno
# Copiar a .env (en la VM, con permisos 600). Nunca commitear .env.
# Los datos del club (WhatsApp, redes, banco, dirección) se editan en
# el panel → Configuración, NO aquí.
#
# Los valores de este archivo sirven tal cual para DESARROLLO LOCAL
# (compose.dev.yaml); solo falta generar BETTER_AUTH_SECRET.
# Los comentarios "VM:" indican el valor para staging/producción.
#
# Generar secretos en PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   base64:  [Convert]::ToBase64String($b)
#   hex:     -join ($b | ForEach-Object { $_.ToString('x2') })
# En Linux/macOS:        openssl rand -base64 32   ·   openssl rand -hex 32
# ───────────────────────────────────────────────────────────────

# General
SITE_ENV=development                       # development | staging | production (≠ production ⇒ noindex)
SITE_URL=http://localhost:3000             # URL pública canónica. VM: https://cachorros.fmartinez.xyz
SITE_DOMAIN=localhost                      # dominio que atiende Caddy. VM: cachorros.fmartinez.xyz
GHCR_NAMESPACE=ghcr.io/[COMPLETAR]         # dueño del repositorio en GitHub (solo VM)
APP_VERSION=dev                            # tag de imagen a desplegar (en la VM lo actualiza deploy.sh)
LOG_LEVEL=info

# Base de datos
POSTGRES_DB=cachorros
POSTGRES_USER=cachorros_admin              # superusuario: solo migrate, ops y restore
POSTGRES_PASSWORD=cachorros_admin_dev      # VM: hex de 24 bytes (no requiere escapar en URLs)
# VM: en ambas URLs el host es "db:5432" (red de Docker) y las claves son las generadas.
DATABASE_ADMIN_URL=postgres://cachorros_admin:cachorros_admin_dev@localhost:5439/cachorros
DATABASE_URL=postgres://cachorros_app:cachorros_app_dev@localhost:5439/cachorros   # rol restringido; migrate lo crea/actualiza
DB_POOL_MAX=5

# Autenticación
BETTER_AUTH_SECRET=                        # base64 de 32 bytes (ver arriba)
AUTH_REQUIRE_2FA=false

# Email (SMTP; GCP bloquea el puerto 25). Desarrollo: Mailpit, bandeja en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025                             # VM: 587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Club Deportivo Los Cachorros <no-responder@cachorros.fmartinez.xyz>"

# Anti-spam (claves de prueba oficiales de Turnstile para desarrollo y CI)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
IP_HASH_SALT=                              # hex de 32 bytes

# Tareas internas
CRON_SECRET=                               # hex de 32 bytes

# Analítica (opcional)
CF_WEB_ANALYTICS_TOKEN=

# Medios
UPLOADS_DIR=./data/uploads                 # VM: /data/uploads
SHARE_CACHE_DIR=./data/cache/share         # VM: /data/cache/share
MAX_UPLOAD_MB=12

# Recursos — perfil e2-micro (e2-small: 768m · 512 · 384m · 128MB · 512MB). Solo VM.
APP_MEMORY_LIMIT=512m
APP_NODE_HEAP_MB=320
DB_MEMORY_LIMIT=256m
PG_SHARED_BUFFERS=64MB
PG_EFFECTIVE_CACHE_SIZE=256MB

# Respaldos (solo VM)
BACKUP_GCS_BUCKET=[COMPLETAR]
BACKUP_AGE_RECIPIENT=age1[COMPLETAR]       # clave PÚBLICA; la privada nunca va al servidor
BACKUP_HEALTHCHECK_URL=                    # opcional

# Seed de demostración (solo staging/desarrollo; nunca valores por defecto)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
